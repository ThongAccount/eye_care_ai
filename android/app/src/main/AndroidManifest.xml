<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Phone Usage habit: reading OS screen-on time via UsageStatsManager.
         User must manually grant this in Settings > Apps > Special access >
         Usage access — there is no runtime permission dialog for it. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Outdoor Time habit: GPS presence sampling -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Reading Time / Sleep habits: accelerometer-based stillness heuristic -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Đo khoảng cách mắt-màn hình khi kiểm tra thị lực (camera trước +
         nhận diện khuôn mặt cục bộ, KHÔNG lưu/gửi ảnh đi đâu cả). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- android.permission.health.READ_SLEEP đã BỊ XOÁ — không dùng Health
         Connect nữa, Sleep giờ ước lượng từ Usage Events (Usage Access đã
         xin ở permission đầu tiên, không cần quyền riêng cho Sleep nữa). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Break Reminder: Android 13+ yêu cầu xin quyền runtime để hiện thông báo -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Break Reminder: cho phép thông báo hết giờ bật full-screen giống chuông báo thức -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Cần để BroadcastReceiver bên dưới tự đặt lại các báo thức nghỉ mắt
         sau khi máy khởi động lại (nếu không có, mọi báo thức đã đặt trước
         đó sẽ mất hẳn sau khi reboot). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Cho phép app xin người dùng loại trừ khỏi tối ưu pin, để hệ thống
         không tự ý "đóng băng" tiến trình nền khiến báo thức nghỉ mắt bị
         trễ/không kêu trên các máy Android quản lý pin gắt (Xiaomi/OPPO/
         Samsung...). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Giúp báo thức nghỉ mắt bắn đúng giờ ngay cả khi máy đang ngủ sâu. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Cần cho Chế độ Focus: bật/tắt Do Not Disturb (chặn thông báo app
         khác) trong lúc làm việc. Đây là quyền "đặc biệt" (special
         permission) — không xin được qua hộp thoại runtime bình thường,
         người dùng phải tự bật trong Cài đặt hệ thống (app chỉ mở đúng màn
         hình cài đặt đó giúp, xem FocusModeHandler.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- Cho phép app cài đặt APK tải về từ GitHub Releases (sideload) — không
         có quyền này, Android sẽ chặn hẳn việc mở trình cài đặt gói khi app
         không phải là nguồn cài đặt "được tin cậy" (ví dụ Play Store). Người
         dùng vẫn cần tự bật "Cho phép từ nguồn này" 1 lần trong Cài đặt hệ
         thống khi cài lần đầu — đây là màn hình hệ thống tự bật lên, app
         không cần code gì thêm cho bước đó. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Cho phép tính năng "Gợi ý độ sáng" tự chỉnh ĐỘ SÁNG HỆ THỐNG (không
         chỉ độ sáng riêng trong app) khớp với ánh sáng môi trường đọc được
         từ cảm biến. Đây là quyền "đặc biệt" (special access) — Android
         không hiện popup xin quyền thông thường, người dùng phải tự bật ở
         màn hình Cài đặt hệ thống; app mở thẳng màn hình đó bằng Intent
         ACTION_MANAGE_WRITE_SETTINGS (xem lib/services/brightness_service.dart). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions"/>
    <application
        android:label="EyeCare AI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- BUG ĐÃ SỬA: hai receiver bên dưới BẮT BUỘC phải khai báo thủ
             công cho package flutter_local_notifications — plugin KHÔNG tự
             đăng ký giúp. Thiếu chúng là lý do chính khiến "Break Reminder"
             không kêu khi app đã bị hệ thống dọn khỏi bộ nhớ (không còn chạy
             nền): AlarmManager vẫn kích hoạt đúng giờ, nhưng không có ai
             lắng nghe để hiển thị notification, nên coi như im lặng. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Feedback via Email (Help & Support): needed so url_launcher can find a mail app -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>