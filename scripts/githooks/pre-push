#!/bin/sh
# Shared pre-push secret guard for eye_care_ai.
# Install (machine-local step — git hooks never transfer via push/clone):
#   ./scripts/setup-hooks.sh
# What it does: blocks pushes that ADD secret-looking lines (nvapi-, sk-,
# ghp/gho/github_pat_, AKIA, Slack tokens, private-key headers). Only ADDED
# lines are scanned, so deletions (e.g. redaction commits) never trip it.
# Bypass (not recommended): git push --no-verify.
PATTERNS='nvapi-[A-Za-z0-9_.-]{20,}|sk-ant-[A-Za-z0-9-]{20,}|sk-[A-Za-z0-9]{20,}|(ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[bpas]-[A-Za-z0-9-]{10,}|BEGIN [A-Z ]*PRIVATE KEY'
ZERO='0000000000000000000000000000000000000000'
blocked=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO" ]; then continue; fi
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  hits=$(git diff --unified=0 "$range" -- . 2>/dev/null | grep '^+' | grep -v '^+++' | grep -E "$PATTERNS" | head -5)
  if [ -n "$hits" ]; then
    echo "pre-push BLOCKED: possible secret added (override with --no-verify):" >&2
    echo "$hits" | cut -c1-120 >&2
    blocked=1
  fi
done
if [ "$blocked" = "1" ]; then exit 1; fi
exit 0
